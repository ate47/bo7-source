        },
        {
            "text": "^BInformation^R^B ^R^BAbout Your Account ^R^Band Retention Period^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "8.",
            "level": "0"
        },
        {
            "text": "^BContacting Us^R^B ^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "9.",
            "level": "0"
        },
        {
            "text": "^BUsers in the United States^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "10.",
            "level": "0"
        },
        {
            "text": "^BYour ^R^BUS ^R^BPrivacy Rights^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "a.",
            "level": "1"
        },
        {
            "text": "^BAdditional ^R^BPrivacy Information for California Residents^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "b.",
            "level": "1"
        },
        {
            "text": "^BPrivacy Information for Nevada Residents^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "c.",
            "level": "1"
        },
        {
            "text": "^BUser^R^Bs^R^B in the E^R^BEA^R^B and the UK^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "11.",
            "level": "0"
        },
        {
            "text": "^BDisclosure to Users Outside the US^R^B,^R^B the ^R^BEEA,^R^B and the UK^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "12.",
            "level": "0"
        },
        {
            "text": "^BDisclosure to Users in Japan^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "13.",
            "level": "0"
