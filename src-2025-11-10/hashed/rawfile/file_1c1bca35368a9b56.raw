            "level": "1"
        },
        {
            "text": "^BUtilisateurs au sein de l’EEE et du Royaume-Uni^R",
            "alignment": "both",
            "indentation": {
                "left": "720"
            },
            "lvl_text": "11.",
            "level": "0"
        },
        {
            "text": "^BDivulgation à des utilisateurs en dehors des États-Unis, de l’EEE et du Royaume-Uni^R",
            "alignment": "both",
            "indentation": {
